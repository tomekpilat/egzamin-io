{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egzamin.io/schemas/cke-paper-v1.json",
  "title": "egzaminio CKE paper import manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "manifest_version", "paper", "permission", "questions"],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_id": { "$ref": "#/$defs/slug" },
    "manifest_version": { "type": "integer", "minimum": 1 },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_document_id", "source_pdf_sha256", "source_url", "source_label", "exam_year", "exam_session", "subject", "variant_code", "question_count"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "source_document_id": { "type": "string", "minLength": 3, "maxLength": 160 },
        "source_pdf_sha256": { "$ref": "#/$defs/sha256" },
        "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "source_label": { "type": "string", "minLength": 3 },
        "exam_year": { "type": "integer", "minimum": 2019, "maximum": 2100 },
        "exam_session": { "enum": ["main", "additional"] },
        "subject": { "enum": ["mathematics", "polish", "english"] },
        "variant_code": { "type": "string", "minLength": 1, "maxLength": 40 },
        "question_count": { "type": "integer", "minimum": 1 }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "verified_by", "verified_at"],
      "properties": {
        "reference": { "type": "string", "minLength": 3, "maxLength": 300 },
        "verified_by": { "type": "string", "minLength": 2, "maxLength": 160 },
        "verified_at": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "maxLength": 2000 }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,119}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "alt"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "alt": { "type": "string", "minLength": 1 },
        "caption": { "type": "string" }
      }
    },
    "contentBlock": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "markdown" }, "text": { "type": "string" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "latex"], "properties": { "type": { "const": "math" }, "latex": { "type": "string" }, "display": { "type": "boolean", "default": true } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "asset_id"], "properties": { "type": { "const": "image" }, "asset_id": { "$ref": "#/$defs/slug" } } },
        { "type": "object", "additionalProperties": false, "required": ["type", "rows"], "properties": { "type": { "const": "table" }, "rows": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } }, "header_rows": { "type": "integer", "minimum": 0, "default": 1 }, "caption": { "type": "string" } } }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "number", "sort_order", "source_pages", "type", "topic", "difficulty", "prompt", "answer_key", "scoring", "explanation"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "number": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
        "sort_order": { "type": "integer", "minimum": 1 },
        "source_pages": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "type": { "enum": ["single_choice", "multiple_choice", "numeric", "short_text", "long_text"] },
        "topic": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": [1, 2, 3] },
        "prompt": { "type": "string", "minLength": 1 },
        "answer_options": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "answer_key": { "type": "object" },
        "scoring": { "type": "object" },
        "explanation": { "type": "string", "minLength": 1 },
        "content_blocks": { "type": "array", "items": { "$ref": "#/$defs/contentBlock" }, "default": [] },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" }, "default": [] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "single_choice" } }, "required": ["type"] },
          "then": {
            "required": ["answer_options"],
            "properties": {
              "answer_options": { "minItems": 4, "maxItems": 4 },
              "answer_key": { "type": "object", "required": ["correct_index"], "properties": { "correct_index": { "type": "integer", "minimum": 0, "maximum": 3 } } }
            }
          }
        }
      ]
    }
  }
}
