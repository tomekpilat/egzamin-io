# Public GA4 web stream identifier. Leave empty to disable Analytics and the consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase runtime configuration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI tutor runtime secrets. Keep them server-side; never prefix them with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
AI_USER_HASH_SECRET=

# Optional AI provider overrides.
AI_PROVIDER_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT_MS=25000

# Stripe Checkout for the one-time Plus package. Keep all STRIPE_* values server-side.
# Leave PAYMENTS_ENABLED=false until the migration, webhook and legal checklist are complete.
PAYMENTS_ENABLED=false
APP_URL=https://egzamin.io
PLUS_ACCESS_UNTIL=2027-07-31T21:59:59Z
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PLUS=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
